# Runtime-only wrapper for the CI-tested glibc linux/amd64 prod binary.
# No shell, package manager, mount helpers or GNU wget in the final image.
FROM debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS store
RUN mkdir -p /app/store && chown 10001:10001 /app/store && chmod 700 /app/store

FROM gcr.io/distroless/base-debian13:nonroot@sha256:a0d70d6a97cd697d9362bc2aae4a6560dd65817e365d0043b07325a97975dc91
WORKDIR /app
COPY --from=store --chown=10001:10001 /app/store /app/store
COPY --chmod=755 zapcast-linux-amd64 /app/zapcast
ENV HOST=0.0.0.0 PORT=3000 STORE_DIR=/app/store LOG_FORMAT=json LOG_LEVEL=info AUTH_MODE=native
VOLUME ["/app/store"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/app/zapcast", "healthcheck"]
USER 10001:10001
ENTRYPOINT ["/app/zapcast"]
