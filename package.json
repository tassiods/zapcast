{
  "name": "zapcast-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.3",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit",
    "pretest:e2e": "python3 scripts/e2e_preflight.py",
    "test:e2e": "node e2e/run.mjs",
    "test:delivery": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "release:dry-run": "python3 scripts/release.py --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
